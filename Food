      sessionStorage.removeItem(STORAGE_KEYS.SESSION_DEV);
      refreshDevPortal();
      showToast('Developer portal locked.');
    }

    function refreshDevPortal() {
      const isLogged = sessionStorage.getItem(STORAGE_KEYS.SESSION_DEV) === 'true';
      const authCard = document.getElementById('devAuthCard');
      const dash = document.getElementById('devDashboardContent');

      if (!isLogged) {
        authCard.classList.remove('hidden');
        dash.classList.add('hidden');
        return;
      }

      authCard.classList.add('hidden');
      dash.classList.remove('hidden');

      const cfg = getConfig();
      document.getElementById('devSystemNameInput').value = cfg.systemName;
      document.getElementById('devDailyQuotaInput').value = cfg.dailyQuota;
      document.getElementById('devAdminIdInput').value = cfg.adminUserId;
      document.getElementById('devAdminPwdInput').value = cfg.adminPassword;
      document.getElementById('devAdminMobileInput').value = cfg.adminMobile;
      lucide.createIcons();
    }

    function saveDevBranding() {
      const newName = document.getElementById('devSystemNameInput').value.trim();
      const newQuota = parseInt(document.getElementById('devDailyQuotaInput').value, 10);

      if (!newName) {
        showToast('System name cannot be empty.', 'error');
        return;
      }
      if (isNaN(newQuota) || newQuota < 1) {
        showToast('Enter a valid daily token quota.', 'error');
        return;
      }

      const cfg = getConfig();
      cfg.systemName = newName;
      cfg.dailyQuota = newQuota;
      saveConfig(cfg);
      showToast(`System updated to "${newName}"!`, 'success');
    }

    function saveDevAdminConfig() {
      const adminId = document.getElementById('devAdminIdInput').value.trim();
      const adminPwd = document.getElementById('devAdminPwdInput').value.trim();
      const adminMob = document.getElementById('devAdminMobileInput').value.trim();

      if (!adminId || !adminPwd) {
        showToast('Admin User ID and Password are required.', 'error');
        return;
      }
      if (!/^\d{10}$/.test(adminMob)) {
        showToast('Admin Mobile Number must be 10 digits.', 'error');
        return;
      }

      const cfg = getConfig();
      cfg.adminUserId = adminId;
      cfg.adminPassword = adminPwd;
      cfg.adminMobile = adminMob;
      saveConfig(cfg);
      showToast('Admin ID, Password & OTP Mobile updated!', 'success');
    }

    function resetSystemToDefaults() {
      openConfirmModal(
        'Reset Entire System?',
        'This will clear all users, tokens, and custom settings back to factory defaults.',
        () => {
          localStorage.removeItem(STORAGE_KEYS.CONFIG);
          localStorage.removeItem(STORAGE_KEYS.USERS);
          localStorage.removeItem(STORAGE_KEYS.TICKETS);
          sessionStorage.clear();
          initDefaultStorage();
          applySystemBranding();
          switchPortal('user');
          showToast('System restored to factory defaults.', 'success');
        }
      );
    }

    // =========================================================================
    // 7. DOWNLOAD 3 SEPARATE STANDALONE HTML FILES
    // =========================================================================
    function openDownloadFilesModal() {
      document.getElementById('filesModal').classList.remove('hidden');
      lucide.createIcons();
    }
    function closeDownloadFilesModal() {
      document.getElementById('filesModal').classList.add('hidden');
    }

    function downloadStandalonePortal(targetPortal) {
      const fileNames = {
        user: 'user-end.html',
        admin: 'admin-end.html',
        dev: 'developer-end.html'
      };
      const portalTitles = {
        user: 'User End — Food Token Booking',
        admin: 'Admin End — Canteen Verification & Reports',
        dev: 'Developer End — Master System Control'
      };

      // Clone current full document HTML and inject a default boot portal script
      let fullHtml = '<!DOCTYPE html>\n' + document.documentElement.outerHTML;
      const bootPatch = `<script>window.__DEFAULT_PORTAL__ = "${targetPortal}";<\/script>\n</head>`;
      fullHtml = fullHtml.replace('</head>', bootPatch);
      fullHtml = fullHtml.replace(/<title>.*?<\/title>/, `<title>${getConfig().systemName} — ${portalTitles[targetPortal]}</title>`);

      const blob = new Blob([fullHtml], { type: 'text/html;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = fileNames[targetPortal];
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);

      showToast(`Downloaded ${fileNames[targetPortal]}!`, 'success');
    }

    // =========================================================================
    // 8. INITIALIZATION ON LOAD
    // =========================================================================
    window.addEventListener('DOMContentLoaded', () => {
      initDefaultStorage();
      applySystemBranding();

      // Support hash routing or standalone file default portal
      const hash = window.location.hash.replace('#', '');
      const initialPortal = window.__DEFAULT_PORTAL__ || (['user', 'admin', 'dev'].includes(hash) ? hash : 'user');
      switchPortal(initialPortal);
      lucide.createIcons();
    });
  </script>
</body>
</html>
