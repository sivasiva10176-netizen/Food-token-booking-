        } else {
          view.classList.add('hidden');
          btn.className = 'py-2 px-2 rounded-xl text-xs font-bold flex items-center justify-center gap-1.5 transition text-emerald-100 hover:bg-white/10';
        }
      });

      if (portal !== 'admin' && qrCameraInstance) {
        stopAdminQrCamera();
      }

      if (portal === 'user') refreshUserPortal();
      if (portal === 'admin') refreshAdminPortal();
      if (portal === 'dev') refreshDevPortal();
      lucide.createIcons();
    }

    // =========================================================================
    // 4. USER END LOGIC (REGISTRATION, OTP/PWD LOGIN, SHIFT BOOKING, TICKET)
    // =========================================================================
    function setUserAuthMode(mode) {
      const loginCard = document.getElementById('userLoginCard');
      const regCard = document.getElementById('userRegisterCard');
      const tabLogin = document.getElementById('userAuthTab-login');
      const tabReg = document.getElementById('userAuthTab-register');

      if (mode === 'login') {
        loginCard.classList.remove('hidden');
        regCard.classList.add('hidden');
        tabLogin.className = 'py-2.5 rounded-xl text-xs font-bold bg-emerald-600 text-white shadow-xs transition';
        tabReg.className = 'py-2.5 rounded-xl text-xs font-bold text-slate-600 hover:bg-slate-50 transition';
      } else {
        loginCard.classList.add('hidden');
        regCard.classList.remove('hidden');
        tabReg.className = 'py-2.5 rounded-xl text-xs font-bold bg-emerald-600 text-white shadow-xs transition';
        tabLogin.className = 'py-2.5 rounded-xl text-xs font-bold text-slate-600 hover:bg-slate-50 transition';
      }
    }

    function setUserLoginMethod(method) {
      const otpBox = document.getElementById('userLoginMethodOtp');
      const pwdBox = document.getElementById('userLoginMethodPwd');
      const btnOtp = document.getElementById('loginMethod-otp');
      const btnPwd = document.getElementById('loginMethod-pwd');

      if (method === 'otp') {
        otpBox.classList.remove('hidden');
        pwdBox.classList.add('hidden');
        btnOtp.className = 'py-2 rounded-lg text-xs font-bold bg-white text-slate-900 shadow-xs';
        btnPwd.className = 'py-2 rounded-lg text-xs font-bold text-slate-500';
      } else {
        otpBox.classList.add('hidden');
        pwdBox.classList.remove('hidden');
        btnPwd.className = 'py-2 rounded-lg text-xs font-bold bg-white text-slate-900 shadow-xs';
        btnOtp.className = 'py-2 rounded-lg text-xs font-bold text-slate-500';
      }
    }

    function syncRegDobPassword() {
      const dob = document.getElementById('regDob').value;
      document.getElementById('regPasswordPreview').value = dob || '';
    }

    function registerNewUser() {
      const userId = document.getElementById('regUserId').value.trim();
      const mobile = document.getElementById('regMobile').value.trim();
      const username = document.getElementById('regUsername').value.trim();
      const dob = document.getElementById('regDob').value;
      const department = document.getElementById('regDepartment').value;
      const room = document.getElementById('regRoom').value;

      // Strict 8-digit User ID validation
      if (!/^\d{8}$/.test(userId)) {
        showToast('User ID must be strictly 8 numeric digits only.', 'error');
        return;
      }
      if (!/^\d{10}$/.test(mobile)) {
        showToast('Please enter a valid 10-digit mobile number.', 'error');
        return;
      }
      if (!username || !dob || !department || !room) {
        showToast('Please fill in all required employee fields.', 'error');
        return;
      }

      const users = getUsers();
      // Condition: User Not repeated mobile number and user id
      if (users.some(u => u.userId === userId)) {
        showToast('This 8-digit User ID is already registered!', 'error');
        return;
      }
      if (users.some(u => u.mobile === mobile)) {
        showToast('This Mobile Number is already registered!', 'error');
        return;
      }

      const newUser = {
        userId,
        username,
        mobile,
        dob,
        password: dob, // Default password = Date of Birth
        department,
        room,
        verified: false, // Condition: user verified admin only
        createdAt: Date.now()
      };

      users.push(newUser);
      saveUsers(users);

      // Auto-login user to view pending verification status
      sessionStorage.setItem(STORAGE_KEYS.SESSION_USER, userId);
      showToast('Registration complete! Awaiting Admin verification.', 'success');
      refreshUserPortal();
    }

    function fillDemoUserLogin() {
      setUserLoginMethod('otp');
      document.getElementById('loginMobileInput').value = '9876543210';
      sendUserLoginOtp();
    }

    function sendUserLoginOtp() {
      const mobile = document.getElementById('loginMobileInput').value.trim();
      if (!/^\d{10}$/.test(mobile)) {
        showToast('Enter a valid 10-digit registered mobile number.', 'error');
        return;
      }
      const user = getUsers().find(u => u.mobile === mobile);
      if (!user) {
        showToast('Mobile number not found. Please complete One-Time Sign Up first.', 'error');
        return;
      }
      document.getElementById('userOtpVerifyBox').classList.remove('hidden');
      triggerSimulatedSmsOtp(mobile, 'loginOtpInput');
    }

    function verifyUserOtpLogin() {
      const mobile = document.getElementById('loginMobileInput').value.trim();
      const enteredOtp = document.getElementById('loginOtpInput').value.trim();

      if (!activeOtpState.code || enteredOtp !== activeOtpState.code || activeOtpState.mobile !== mobile) {
        showToast('Invalid 6-digit OTP code. Please check SMS banner.', 'error');
        return;
      }

      const user = getUsers().find(u => u.mobile === mobile);
      if (!user) return;

      dismissSmsBanner();
      sessionStorage.setItem(STORAGE_KEYS.SESSION_USER, user.userId);
      showToast(`Welcome back, ${user.username}! Profile loaded.`, 'success');
      refreshUserPortal();
    }

    function loginUserWithPassword() {
      const userId = document.getElementById('loginUserIdInput').value.trim();
      const pwd = document.getElementById('loginUserDobPwdInput').value;

      if (!/^\d{8}$/.test(userId)) {
        showToast('Enter your 8-digit User ID.', 'error');
        return;
      }
      const user = getUsers().find(u => u.userId === userId && u.password === pwd);
      if (!user) {
        showToast('Invalid User ID or Date of Birth password.', 'error');
        return;
      }

      sessionStorage.setItem(STORAGE_KEYS.SESSION_USER, user.userId);
      showToast(`Signed in as ${user.username}`, 'success');
      refreshUserPortal();
    }

    function logoutUser() {
      sessionStorage.removeItem(STORAGE_KEYS.SESSION_USER);
      clearInterval(window._cancelCountdownTimer);
      refreshUserPortal();
      showToast('Logged out successfully.');
    }

    // Shift to Meal & Serving Time Mapping
    function getMealScheduleForShift(shiftValue, compOffMealValue) {
      if (shiftValue === 'General Shift (9 to 5)') {
        return { meal: 'Dinner', time: '7:30 PM' };
      }
      if (shiftValue === 'First Shift (6 to 2)') {
        return { meal: 'Dinner', time: '7:30 PM' };
      }
      if (shiftValue === 'Second Shift (2 to 10)') {
        return { meal: 'Breakfast', time: '7:30 AM' };
      }
      if (shiftValue === 'Night Shift (10 to 6)') {
        return { meal: 'Lunch', time: '12:30 PM' };
      }
      // Computer Off (Comp Off)
      const selected = compOffMealValue || 'Lunch';
      const timeMap = {
        'Breakfast': '7:30 AM',
        'Lunch': '12:30 PM',
        'Dinner': '7:30 PM'
      };
      return { meal: selected, time: timeMap[selected] };
    }

    function handleShiftChange() {
      const shift = document.getElementById('bookingShiftSelect').value;
      const compOffBox = document.getElementById('compOffMealBox');
      if (shift === 'Comp Off (Computer Off)') {
        compOffBox.classList.remove('hidden');
      } else {
        compOffBox.classList.add('hidden');
      }
      updateMealPreview();
    }

    function updateMealPreview() {
      const shift = document.getElementById('bookingShiftSelect').value;
      const checkedRadio = document.querySelector('input[name="compOffMeal"]:checked');
      const compMeal = checkedRadio ? checkedRadio.value : 'Lunch';
      const schedule = getMealScheduleForShift(shift, compMeal);

      document.getElementById('previewMealType').textContent = schedule.meal;
      document.getElementById('previewServingTime').textContent = schedule.time;
    }

    function confirmAndBookToken() {
      const currentUserId = sessionStorage.getItem(STORAGE_KEYS.SESSION_USER);
      const user = getUsers().find(u => u.userId === currentUserId);
      if (!user) return;

      if (!user.verified) {
        showToast('Only Admin-verified users can book tokens.', 'error');
        return;
      }

      const today = getTodayDateString();
      const tickets = getTickets();

      // Condition: One user one day one ticket only booking
      const existingTodayTicket = tickets.find(t => t.userId === user.userId && t.date === today && t.status !== 'CANCELLED');
      if (existingTodayTicket) {
        showToast('You have already booked a token for today!', 'error');
        refreshUserPortal();
        return;
      }

      // Check balance quota
      const cfg = getConfig();
      const activeTodayCount = tickets.filter(t => t.date === today && t.status !== 'CANCELLED').length;
      if (activeTodayCount >= Number(cfg.dailyQuota)) {
        showToast('Daily canteen token quota reached!', 'error');
        return;
      }

      const shift = document.getElementById('bookingShiftSelect').value;
      const checkedRadio = document.querySelector('input[name="compOffMeal"]:checked');
      const compMeal = checkedRadio ? checkedRadio.value : 'Lunch';
      const schedule = getMealScheduleForShift(shift, compMeal);

      const newTicket = {
        ticketId: 'TKN-' + Math.floor(100000 + Math.random() * 900000),
        userId: user.userId,
        username: user.username,
        mobile: user.mobile,
        department: user.department,
        room: user.room,
        shift: shift,
        meal: schedule.meal,
        servingTime: schedule.time,
        date: today,
        bookedAt: Date.now(),
        status: 'ACTIVE' // ACTIVE | USED | CANCELLED
      };

      tickets.push(newTicket);
      saveTickets(tickets);

      showToast('Food Token Confirmed! Booking form locked.', 'success');
      refreshUserPortal();
    }

    function refreshUserPortal() {
      const currentUserId = sessionStorage.getItem(STORAGE_KEYS.SESSION_USER);
      const authSec = document.getElementById('userAuthSection');
      const dashSec = document.getElementById('userDashboardSection');

      if (!currentUserId) {
        authSec.classList.remove('hidden');
        dashSec.classList.add('hidden');
        return;
      }

      const user = getUsers().find(u => u.userId === currentUserId);
      if (!user) {
        sessionStorage.removeItem(STORAGE_KEYS.SESSION_USER);
        authSec.classList.remove('hidden');
        dashSec.classList.add('hidden');
        return;
      }

      authSec.classList.add('hidden');
      dashSec.classList.remove('hidden');

      // Populate Profile
      document.getElementById('userAvatarInitial').textContent = user.username.charAt(0).toUpperCase();
      document.getElementById('dashUserName').textContent = user.username;
      document.getElementById('dashUserId').textContent = user.userId;
      document.getElementById('dashUserMobile').textContent = user.mobile;
      document.getElementById('dashUserDept').textContent = user.department;
      document.getElementById('dashUserRoom').textContent = user.room;
      document.getElementById('dashUserDob').textContent = user.dob;

      const badge = document.getElementById('dashUserVerifyBadge');
      const pendingCard = document.getElementById('userPendingVerificationCard');
      const bookingCard = document.getElementById('userBookingFormCard');
      const ticketCard = document.getElementById('userActiveTicketCard');

      if (!user.verified) {
        badge.textContent = 'Pending Admin';
        badge.className = 'px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800';
        pendingCard.classList.remove('hidden');
        bookingCard.classList.add('hidden');
        ticketCard.classList.add('hidden');
        return;
      }

      badge.textContent = 'Verified';
      badge.className = 'px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800';
      pendingCard.classList.add('hidden');

      // Check if user already has a non-cancelled ticket today
      const today = getTodayDateString();
