    function startUserCancelCountdown(ticket) {
      clearInterval(window._cancelCountdownTimer);
      const ONE_HOUR_MS = 60 * 60 * 1000;
      const btn = document.getElementById('userCancelTicketBtn');
      const countdownEl = document.getElementById('cancelCountdownText');

      function updateTimer() {
        if (ticket.status === 'USED') {
          btn.disabled = true;
          countdownEl.textContent = 'Locked (Already Verified)';
          clearInterval(window._cancelCountdownTimer);
          return;
        }
        const elapsed = Date.now() - ticket.bookedAt;
        const remaining = ONE_HOUR_MS - elapsed;

        if (remaining <= 0) {
          btn.disabled = true;
          countdownEl.textContent = 'Expired (Admin Cancel Only)';
          clearInterval(window._cancelCountdownTimer);
        } else {
          btn.disabled = false;
          const mins = Math.floor(remaining / 60000);
          const secs = Math.floor((remaining % 60000) / 1000);
          countdownEl.textContent = `Remaining: ${String(mins).padStart(2, '0')}m ${String(secs).padStart(2, '0')}s`;
        }
      }

      updateTimer();
      window._cancelCountdownTimer = setInterval(updateTimer, 1000);
    }

