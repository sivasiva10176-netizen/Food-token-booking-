    // =========================================================================
    // 2. UI HELPERS: TOAST, CONFIRM MODAL & SIMULATED MOBILE SMS OTP ENGINE
    // =========================================================================
    let activeOtpState = {
      code: null,
      targetInputId: null,
      mobile: null
    };

    function showToast(message, type = 'info') {
      const box = document.getElementById('toastBox');
      const inner = document.getElementById('toastInner');
      const icon = document.getElementById('toastIcon');
      const text = document.getElementById('toastText');

      text.textContent = message;
      inner.className = 'px-4 py-3 rounded-2xl shadow-xl flex items-center gap-3 border ';
      if (type === 'success') {
        inner.className += 'bg-emerald-950 text-white border-emerald-700';
        icon.innerHTML = '<i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-400"></i>';
      } else if (type === 'error') {
        inner.className += 'bg-rose-950 text-white border-rose-700';
        icon.innerHTML = '<i data-lucide="alert-circle" class="w-5 h-5 text-rose-400"></i>';
      } else {
        inner.className += 'bg-slate-900 text-white border-slate-700';
        icon.innerHTML = '<i data-lucide="info" class="w-5 h-5 text-sky-400"></i>';
      }
      box.classList.remove('hidden');
      lucide.createIcons();
      clearTimeout(window._toastTimer);
      window._toastTimer = setTimeout(() => box.classList.add('hidden'), 3400);
    }

    let confirmCallback = null;
    function openConfirmModal(title, message, onConfirm) {
      document.getElementById('confirmTitle').textContent = title;
      document.getElementById('confirmMessage').textContent = message;
      confirmCallback = onConfirm;
      document.getElementById('confirmModal').classList.remove('hidden');
      document.getElementById('confirmYesBtn').onclick = () => closeConfirmModal(true);
    }
    function closeConfirmModal(confirmed) {
      document.getElementById('confirmModal').classList.add('hidden');
      if (confirmed && typeof confirmCallback === 'function') {
        confirmCallback();
      }
      confirmCallback = null;
    }

    // Simulated Real Mobile OTP Engine
    function triggerSimulatedSmsOtp(mobileNumber, targetInputId) {
      const code = String(Math.floor(100000 + Math.random() * 900000));
      activeOtpState = { code, targetInputId, mobile: mobileNumber };

      const cfg = getConfig();
      document.getElementById('smsAppName').textContent = cfg.systemName;
      document.getElementById('smsOtpCodeDisplay').textContent = code;
      document.getElementById('smsTargetMobile').textContent = `+91 ${mobileNumber}`;

      const banner = document.getElementById('smsOtpBanner');
      banner.classList.remove('hidden');
      lucide.createIcons();
    }

    function autoFillActiveOtp() {
      if (activeOtpState.code && activeOtpState.targetInputId) {
        const input = document.getElementById(activeOtpState.targetInputId);
        if (input) {
          input.value = activeOtpState.code;
          input.focus();
          showToast('6-digit OTP auto-filled from SMS!', 'success');
        }
      }
    }

    function dismissSmsBanner() {
      document.getElementById('smsOtpBanner').classList.add('hidden');
    }

    // =========================================================================
    // 3. PORTAL NAVIGATION & BRANDING SYNC
    // =========================================================================
    let currentPortal = 'user';
    let qrCameraInstance = null;

    function applySystemBranding() {
      const cfg = getConfig();
      document.title = `${cfg.systemName} — Food Token Booking System`;
      document.getElementById('headerSystemName').textContent = cfg.systemName;
      document.getElementById('ticketBrandHeader').textContent = cfg.systemName;
      document.getElementById('headerTodayDate').textContent = new Date().toLocaleDateString('en-IN', {
        weekday: 'short', day: '2-digit', month: 'short', year: 'numeric'
      });
    }

    function switchPortal(portal) {
      currentPortal = portal;
      ['user', 'admin', 'dev'].forEach(p => {
        const view = document.getElementById(`portal-${p}`);
        const btn = document.getElementById(`portalBtn-${p}`);
