<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Siva Food — Smart Canteen Token Booking System</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Inter & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  <!-- QR Code Generator Library -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  <!-- HTML5 QR Code Scanner Library -->
  <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
  <!-- jsPDF for Ticket PDF Download -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <!-- SheetJS (XLSX) for Room List Excel Download -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
          colors: {
            brand: {
              50: '#ecfdf5',
              100: '#d1fae5',
              500: '#10b981',
              600: '#059669',
              700: '#047857',
              900: '#064e3b',
            }
          }
        }
      }
    }
  </script>
  <style>
    body {
      font-family: 'Inter', sans-serif;
      background-color: #f1f5f9;
      -webkit-tap-highlight-color: transparent;
    }
    /* Hide scrollbars cleanly where needed */
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

    /* Simulated iOS/Android SMS Banner Animation */
    @keyframes slideDownSMS {
      0% { transform: translate(-50%, -120%); opacity: 0; }
      100% { transform: translate(-50%, 0); opacity: 1; }
    }
    .sms-banner-enter {
      animation: slideDownSMS 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* Ticket perforated edge effect */
    .ticket-notch-left, .ticket-notch-right {
      position: absolute;
      width: 22px;
      height: 22px;
      background-color: #f1f5f9;
      border-radius: 9999px;
      top: 50%;
      transform: translateY(-50%);
    }
    .ticket-notch-left { left: -11px; }
    .ticket-notch-right { right: -11px; }
  </style>
</head>
<body class="min-h-screen flex flex-col items-center justify-start bg-slate-200 text-slate-800">

  <!-- SIMULATED MOBILE SMS OTP BANNER (Floating Top Notification) -->
  <div id="smsOtpBanner" class="hidden fixed top-3 left-1/2 -translate-x-1/2 w-[94%] max-w-md z-50 sms-banner-enter">
    <div class="bg-slate-900/95 backdrop-blur-md text-white rounded-2xl shadow-2xl border border-slate-700 p-3.5">
      <div class="flex items-start justify-between gap-2">
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-xl bg-emerald-500/20 border border-emerald-400/40 flex items-center justify-center text-emerald-400 shrink-0">
            <i data-lucide="message-square-code" class="w-5 h-5"></i>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="text-xs font-bold uppercase tracking-wider text-emerald-400">VM-SIVAFOOD • SMS</span>
              <span class="text-[10px] text-slate-400">Just now</span>
            </div>
            <p class="text-xs text-slate-200 mt-0.5 leading-snug">
              Your <span id="smsAppName" class="font-semibold text-white">Siva Food</span> verification OTP is
              <span id="smsOtpCodeDisplay" class="font-mono font-bold text-base text-amber-300 tracking-widest bg-slate-800 px-1.5 py-0.5 rounded">000000</span>
            </p>
            <p class="text-[10px] text-slate-400 mt-0.5">Sent to <span id="smsTargetMobile" class="font-mono text-slate-300"></span></p>
          </div>
        </div>
        <button onclick="dismissSmsBanner()" class="text-slate-400 hover:text-white p-1">
          <i data-lucide="x" class="w-4 h-4"></i>
        </button>
      </div>
      <div class="mt-2.5 pt-2 border-t border-slate-800 flex items-center justify-between gap-2">
        <span class="text-[11px] text-slate-400">One-tap auto verification ready</span>
        <button onclick="autoFillActiveOtp()" class="px-3 py-1.5 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs flex items-center gap-1.5 transition active:scale-95">
          <i data-lucide="sparkles" class="w-3.5 h-3.5"></i>
          Auto-Fill OTP
        </button>
      </div>
    </div>
  </div>

  <!-- TOAST MESSAGE BOX (Replaces alert/confirm) -->
  <div id="toastBox" class="hidden fixed bottom-20 left-1/2 -translate-x-1/2 w-[90%] max-w-sm z-50 transition-all duration-300">
    <div id="toastInner" class="bg-slate-900 text-white px-4 py-3 rounded-2xl shadow-xl flex items-center gap-3 border border-slate-700">
      <div id="toastIcon" class="shrink-0"></div>
      <p id="toastText" class="text-xs font-medium leading-snug flex-1"></p>
    </div>
  </div>

  <!-- CONFIRMATION MODAL (Replaces window.confirm) -->
  <div id="confirmModal" class="hidden fixed inset-0 bg-slate-950/60 backdrop-blur-xs z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-sm w-full p-5 shadow-2xl border border-slate-100">
      <div class="w-11 h-11 rounded-2xl bg-amber-100 text-amber-600 flex items-center justify-center mb-3">
        <i data-lucide="alert-triangle" class="w-6 h-6"></i>
      </div>
      <h3 id="confirmTitle" class="text-base font-bold text-slate-900">Confirm Action</h3>
      <p id="confirmMessage" class="text-xs text-slate-600 mt-1.5 leading-relaxed"></p>
      <div class="mt-5 grid grid-cols-2 gap-2.5">
        <button onclick="closeConfirmModal(false)" class="py-2.5 px-4 rounded-xl border border-slate-200 text-slate-700 font-semibold text-xs hover:bg-slate-50">Cancel</button>
        <button id="confirmYesBtn" class="py-2.5 px-4 rounded-xl bg-rose-600 text-white font-semibold text-xs hover:bg-rose-700">Confirm</button>
      </div>
    </div>
  </div>

  <!-- MOBILE APP SHELL CONTAINER -->
  <div class="w-full max-w-md min-h-screen bg-slate-100 shadow-2xl flex flex-col relative overflow-x-hidden border-x border-slate-200">

    <!-- TOP APP HEADER & PORTAL SWITCHER -->
    <header class="bg-gradient-to-r from-emerald-700 via-emerald-600 to-teal-600 text-white px-4 pt-4 pb-3 sticky top-0 z-30 shadow-md">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <div class="w-10 h-10 rounded-2xl bg-white/15 backdrop-blur-xs border border-white/25 flex items-center justify-center shadow-inner">
            <i data-lucide="utensils-crossed" class="w-5 h-5 text-white"></i>
          </div>
          <div>
            <h1 id="headerSystemName" class="text-lg font-extrabold tracking-tight leading-none">Siva Food</h1>
            <p class="text-[11px] text-emerald-100 font-medium mt-0.5 flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-300 animate-pulse"></span>
              <span id="headerTodayDate"></span>
            </p>
          </div>
        </div>
        <button onclick="openDownloadFilesModal()" title="Download 3 Separate HTML Files" class="px-2.5 py-1.5 rounded-xl bg-white/15 hover:bg-white/25 border border-white/25 text-[11px] font-semibold flex items-center gap-1.5 transition active:scale-95">
          <i data-lucide="download" class="w-3.5 h-3.5"></i>
          <span>3 Files</span>
        </button>
      </div>

      <!-- 3-PORTAL ROLE SWITCHER PILLS -->
      <div class="mt-3 bg-emerald-950/35 p-1 rounded-2xl grid grid-cols-3 gap-1 border border-white/10">
        <button id="portalBtn-user" onclick="switchPortal('user')" class="py-2 px-2 rounded-xl text-xs font-bold flex items-center justify-center gap-1.5 transition bg-white text-emerald-800 shadow-sm">
          <i data-lucide="user" class="w-3.5 h-3.5"></i>
          <span>User End</span>
        </button>
        <button id="portalBtn-admin" onclick="switchPortal('admin')" class="py-2 px-2 rounded-xl text-xs font-bold flex items-center justify-center gap-1.5 transition text-emerald-100 hover:bg-white/10">
          <i data-lucide="shield-check" class="w-3.5 h-3.5"></i>
          <span>Admin End</span>
        </button>
        <button id="portalBtn-dev" onclick="switchPortal('dev')" class="py-2 px-2 rounded-xl text-xs font-bold flex items-center justify-center gap-1.5 transition text-emerald-100 hover:bg-white/10">
          <i data-lucide="code-2" class="w-3.5 h-3.5"></i>
          <span>Developer</span>
        </button>
      </div>
    </header>

    <!-- ===================================================================== -->
    <!-- PORTAL 1: USER END                                                    -->
    <!-- ===================================================================== -->
    <main id="portal-user" class="flex-1 p-4 pb-24 space-y-4">

      <!-- USER AUTH SECTION (Shown when no user logged in) -->
      <div id="userAuthSection" class="space-y-4">
        <!-- Auth Mode Tabs -->
        <div class="bg-white p-1.5 rounded-2xl shadow-xs border border-slate-200 grid grid-cols-2 gap-1.5">
          <button id="userAuthTab-login" onclick="setUserAuthMode('login')" class="py-2.5 rounded-xl text-xs font-bold bg-emerald-600 text-white shadow-xs transition">
            Returning Login (OTP / ID)
          </button>
          <button id="userAuthTab-register" onclick="setUserAuthMode('register')" class="py-2.5 rounded-xl text-xs font-bold text-slate-600 hover:bg-slate-50 transition">
            One-Time Sign Up
          </button>
        </div>

        <!-- RETURNING USER LOGIN FORM -->
        <div id="userLoginCard" class="bg-white rounded-3xl p-5 shadow-sm border border-slate-200/80 space-y-4">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-base font-extrabold text-slate-900">Employee Token Login</h2>
              <p class="text-xs text-slate-500 mt-0.5">Auto-loads profile & instant token booking</p>
            </div>
            <span class="px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 text-[10px] font-bold border border-emerald-200">Quick Access</span>
          </div>

          <!-- Login Method Toggle -->
          <div class="grid grid-cols-2 gap-2 p-1 bg-slate-100 rounded-xl">
            <button id="loginMethod-otp" onclick="setUserLoginMethod('otp')" class="py-2 rounded-lg text-xs font-bold bg-white text-slate-900 shadow-xs">Mobile + OTP</button>
            <button id="loginMethod-pwd" onclick="setUserLoginMethod('pwd')" class="py-2 rounded-lg text-xs font-bold text-slate-500">User ID + DOB</button>
          </div>

          <!-- Method A: Mobile Number + Simulated SMS OTP -->
          <div id="userLoginMethodOtp" class="space-y-3">
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Registered Mobile Number</label>
              <div class="flex gap-2">
                <input id="loginMobileInput" type="tel" maxlength="10" placeholder="Enter 10-digit mobile" class="flex-1 px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-emerald-500" />
                <button onclick="sendUserLoginOtp()" class="px-3.5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold shrink-0 transition active:scale-95">
                  Send OTP
                </button>
              </div>
            </div>

            <div id="userOtpVerifyBox" class="hidden space-y-3 pt-1">
              <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">6-Digit SMS OTP Code</label>
                <input id="loginOtpInput" type="text" maxlength="6" placeholder="••••••" class="w-full px-3.5 py-2.5 rounded-xl border border-emerald-400 bg-emerald-50/40 text-center text-lg font-mono font-bold tracking-[0.4em] focus:outline-none focus:ring-2 focus:ring-emerald-500" />
              </div>
              <button onclick="verifyUserOtpLogin()" class="w-full py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm shadow-md shadow-emerald-600/20 transition active:scale-98">
                Verify OTP & Continue
              </button>
            </div>
          </div>

          <!-- Method B: 8-Digit User ID + DOB Password -->
          <div id="userLoginMethodPwd" class="hidden space-y-3">
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">User ID (8 Digits Only)</label>
              <input id="loginUserIdInput" type="text" maxlength="8" inputmode="numeric" placeholder="e.g. 10020030" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-emerald-500" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Password (Default: Date of Birth)</label>
              <input id="loginUserDobPwdInput" type="date" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500" />
            </div>
            <button onclick="loginUserWithPassword()" class="w-full py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm shadow-md shadow-emerald-600/20 transition active:scale-98">
              Sign In with Password
            </button>
          </div>

          <!-- Demo Quick Fill Helper -->
          <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-500">
            <span>Demo Verified User: <strong class="font-mono text-slate-700">9876543210</strong> (ID: <strong class="font-mono text-slate-700">12345678</strong>)</span>
            <button onclick="fillDemoUserLogin()" class="text-emerald-700 font-bold underline">Auto-Fill</button>
          </div>
        </div>

        <!-- ONE-TIME SIGN UP FORM -->
        <div id="userRegisterCard" class="hidden bg-white rounded-3xl p-5 shadow-sm border border-slate-200/80 space-y-3.5">
          <div>
            <h2 class="text-base font-extrabold text-slate-900">One-Time Employee Sign Up</h2>
            <p class="text-xs text-slate-500 mt-0.5">Requires Admin verification before booking tokens</p>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-[11px] font-bold text-slate-700 mb-1">User ID (8 Digits) *</label>
              <input id="regUserId" type="text" maxlength="8" inputmode="numeric" placeholder="8-digit ID" class="w-full px-3 py-2.5 rounded-xl border border-slate-300 text-xs font-mono focus:outline-none focus:ring-2 focus:ring-emerald-500" />
            </div>
            <div>
              <label class="block text-[11px] font-bold text-slate-700 mb-1">Mobile Number *</label>
              <input id="regMobile" type="tel" maxlength="10" inputmode="numeric" placeholder="10-digit mobile" class="w-full px-3 py-2.5 rounded-xl border border-slate-300 text-xs font-mono focus:outline-none focus:ring-2 focus:ring-emerald-500" />
            </div>
          </div>

          <div>
            <label class="block text-[11px] font-bold text-slate-700 mb-1">Username (Full Name) *</label>
            <input id="regUsername" type="text" placeholder="Enter employee full name" class="w-full px-3 py-2.5 rounded-xl border border-slate-300 text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500" />
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-[11px] font-bold text-slate-700 mb-1">Date of Birth *</label>
              <input id="regDob" type="date" onchange="syncRegDobPassword()" class="w-full px-3 py-2.5 rounded-xl border border-slate-300 text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500" />
            </div>
            <div>
              <label class="block text-[11px] font-bold text-slate-700 mb-1">Default Password</label>
              <input id="regPasswordPreview" type="text" readonly placeholder="Auto = DOB" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 bg-slate-50 text-slate-500 text-xs font-mono" />
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-[11px] font-bold text-slate-700 mb-1">Department *</label>
              <select id="regDepartment" class="w-full px-3 py-2.5 rounded-xl border border-slate-300 text-xs bg-white focus:outline-none focus:ring-2 focus:ring-emerald-500">
                <option value="">Select Dept</option>
                <option value="Store">Store</option>
                <option value="Mission">Mission</option>
                <option value="Foundry">Foundry</option>
                <option value="Lpdc">Lpdc</option>
                <option value="Paint">Paint</option>
                <option value="Whouse">Whouse</option>
                <option value="Planning">Planning</option>
                <option value="Manufacturing">Manufacturing</option>
                <option value="EEPD">EEPD</option>
              </select>
            </div>
            <div>
              <label class="block text-[11px] font-bold text-slate-700 mb-1">Room Number *</label>
              <select id="regRoom" class="w-full px-3 py-2.5 rounded-xl border border-slate-300 text-xs bg-white focus:outline-none focus:ring-2 focus:ring-emerald-500">
                <option value="">Select Room</option>
                <option value="1">Room 1</option>
                <option value="2">Room 2</option>
                <option value="3">Room 3</option>
                <option value="4">Room 4</option>
                <option value="5">Room 5</option>
                <option value="6">Room 6</option>
                <option value="7">Room 7</option>
                <option value="8">Room 8</option>
                <option value="9">Room 9</option>
                <option value="10">Room 10</option>
                <option value="11">Room 11</option>
                <option value="12">Room 12</option>
                <option value="13">Room 13</option>
                <option value="14">Room 14</option>
                <option value="15">Room 15</option>
                <option value="16">Room 16</option>
                <option value="17">Room 17</option>
                <option value="18">Room 18</option>
                <option value="New hostel">New hostel</option>
                <option value="Outside room">Outside room</option>
              </select>
            </div>
          </div>

          <button onclick="registerNewUser()" class="w-full py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm shadow-md shadow-emerald-600/20 transition active:scale-98 mt-1">
            Complete One-Time Registration
          </button>
        </div>
      </div>

      <!-- USER DASHBOARD SECTION (Shown after User Login) -->
      <div id="userDashboardSection" class="hidden space-y-4">

        <!-- Employee Profile Card -->
        <div class="bg-white rounded-3xl p-4 shadow-sm border border-slate-200/80">
          <div class="flex items-start justify-between gap-2">
            <div class="flex items-center gap-3">
              <div class="w-11 h-11 rounded-2xl bg-emerald-100 text-emerald-700 font-extrabold text-base flex items-center justify-center">
                <span id="userAvatarInitial">U</span>
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <h3 id="dashUserName" class="text-sm font-extrabold text-slate-900">Employee Name</h3>
                  <span id="dashUserVerifyBadge" class="px-2 py-0.5 rounded-full text-[10px] font-bold"></span>
                </div>
                <p class="text-[11px] text-slate-500 font-mono mt-0.5">
                  ID: <span id="dashUserId" class="font-bold text-slate-700"></span> • <span id="dashUserMobile"></span>
                </p>
              </div>
            </div>
            <button onclick="logoutUser()" class="p-2 rounded-xl bg-slate-100 hover:bg-rose-50 text-slate-600 hover:text-rose-600 transition" title="Logout">
              <i data-lucide="log-out" class="w-4 h-4"></i>
            </button>
          </div>

          <div class="mt-3 pt-3 border-t border-slate-100 grid grid-cols-3 gap-2 text-center">
            <div class="bg-slate-50 rounded-xl p-2">
              <span class="block text-[10px] text-slate-400 uppercase font-bold">Department</span>
              <span id="dashUserDept" class="text-xs font-bold text-slate-800">-</span>
            </div>
            <div class="bg-slate-50 rounded-xl p-2">
              <span class="block text-[10px] text-slate-400 uppercase font-bold">Room No</span>
              <span id="dashUserRoom" class="text-xs font-bold text-slate-800">-</span>
            </div>
            <div class="bg-slate-50 rounded-xl p-2">
              <span class="block text-[10px] text-slate-400 uppercase font-bold">DOB / Pass</span>
              <span id="dashUserDob" class="text-xs font-mono font-bold text-slate-800">-</span>
            </div>
          </div>
        </div>

        <!-- UNVERIFIED USER WARNING BANNER (Enforces: user verified admin only) -->
        <div id="userPendingVerificationCard" class="hidden bg-amber-50 border border-amber-200 rounded-3xl p-5 text-center space-y-2.5">
          <div class="w-12 h-12 rounded-2xl bg-amber-100 text-amber-600 flex items-center justify-center mx-auto">
            <i data-lucide="clock" class="w-6 h-6"></i>
          </div>
          <h3 class="text-sm font-extrabold text-amber-900">Admin Verification Pending</h3>
          <p class="text-xs text-amber-800 leading-relaxed">
            Your account is registered, but food token booking is locked until an <strong>Admin verifies your profile</strong>. Please contact the canteen admin or switch to <strong>Admin End</strong> to approve your User ID.
          </p>
        </div>

        <!-- SHIFT TOKEN BOOKING CARD (Hidden automatically once booked today!) -->
        <div id="userBookingFormCard" class="hidden bg-white rounded-3xl p-5 shadow-sm border border-slate-200/80 space-y-4">
          <div class="flex items-center justify-between">
            <div>
              <h3 class="text-base font-extrabold text-slate-900">Book Today's Food Token</h3>
              <p class="text-xs text-slate-500">1 User • 1 Day • 1 Token Only</p>
            </div>
            <span class="px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 text-[10px] font-bold border border-emerald-200">Verified User</span>
          </div>

          <!-- Shift Selection -->
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1.5">Select Your Shift Entry *</label>
            <select id="bookingShiftSelect" onchange="handleShiftChange()" class="w-full px-3.5 py-3 rounded-xl border border-slate-300 text-xs font-semibold bg-white focus:outline-none focus:ring-2 focus:ring-emerald-500">
              <option value="General Shift (9 to 5)">General Shift (9:00 AM to 5:00 PM)</option>
              <option value="First Shift (6 to 2)">First Shift (6:00 AM to 2:00 PM)</option>
              <option value="Second Shift (2 to 10)">Second Shift (2:00 PM to 10:00 PM)</option>
              <option value="Night Shift (10 to 6)">Night Shift (10:00 PM to 6:00 AM)</option>
              <option value="Comp Off (Computer Off)">Computer Off (Comp Off)</option>
            </select>
          </div>

          <!-- Comp Off Meal Selector (Visible ONLY when Computer Off is selected) -->
          <div id="compOffMealBox" class="hidden bg-indigo-50/70 border border-indigo-200 rounded-2xl p-3.5 space-y-2">
            <div class="flex items-center justify-between">
