    // Condition: admin ticket verifying current date only pass
    function verifyScannedToken(rawInput) {
      const resultBox = document.getElementById('scanVerificationResult');
      resultBox.classList.remove('hidden');

      let tokenId = (rawInput || '').trim();
      try {
        const parsed = JSON.parse(tokenId);
        if (parsed.ticketId) tokenId = parsed.ticketId;
      } catch (e) {
        // Plain Token ID string
      }

      if (!tokenId) {
        resultBox.className = 'rounded-2xl p-3.5 border bg-rose-50 border-rose-200 text-rose-800 text-xs font-bold';
        resultBox.textContent = 'Please scan a valid QR code or enter a Token ID.';
        return;
      }

      const tickets = getTickets();
      const idx = tickets.findIndex(t => t.ticketId.toUpperCase() === tokenId.toUpperCase());

      if (idx === -1) {
        resultBox.className = 'rounded-2xl p-3.5 border bg-rose-50 border-rose-200 text-rose-800 text-xs font-bold';
        resultBox.innerHTML = `INVALID TOKEN: <span class="font-mono">${tokenId}</span> not found in system.`;
        return;
      }

      const ticket = tickets[idx];
      const today = getTodayDateString();

      if (ticket.status === 'CANCELLED') {
        resultBox.className = 'rounded-2xl p-3.5 border bg-rose-50 border-rose-200 text-rose-800 text-xs font-bold';
        resultBox.innerHTML = `REJECTED: Token <span class="font-mono">${ticket.ticketId}</span> was CANCELLED.`;
        return;
      }

      // Strict Current-Date Only Check
      if (ticket.date !== today) {
        resultBox.className = 'rounded-2xl p-3.5 border bg-rose-50 border-rose-200 text-rose-800 text-xs font-bold';
        resultBox.innerHTML = `DATE MISMATCH REJECTED: Token date (${ticket.date}) does not match current date (${today}).`;
        return;
      }

      if (ticket.status === 'USED') {
        resultBox.className = 'rounded-2xl p-3.5 border bg-amber-50 border-amber-200 text-amber-900 text-xs font-bold';
        resultBox.innerHTML = `ALREADY REDEEMED: Token <span class="font-mono">${ticket.ticketId}</span> (${ticket.username}) was already verified.`;
        return;
      }

      // Mark Verified & Pass
      tickets[idx].status = 'USED';
      tickets[idx].verifiedAt = Date.now();
      saveTickets(tickets);

      resultBox.className = 'rounded-2xl p-3.5 border bg-emerald-50 border-emerald-300 text-emerald-900 text-xs space-y-1';
      resultBox.innerHTML = `
        <div class="font-extrabold text-emerald-700 flex items-center gap-1.5">
          <span>✔ VERIFIED — CURRENT DATE PASS</span>
        </div>
        <div><strong>${ticket.username}</strong> (ID: <span class="font-mono">${ticket.userId}</span>)</div>
        <div>Meal: <strong>${ticket.meal}</strong> (${ticket.servingTime}) • Room ${ticket.room}</div>
      `;
      showToast(`Token ${ticket.ticketId} verified & passed!`, 'success');
      updateAdminCounters();
      renderAdminTicketsList();
    }

